#!/usr/bin/env bash

ENV=${1:-local}
INTERVAL=${2:-2}

case "$ENV" in
  local)
    BASE_URL="http://localhost:8080"
    ;;
  dev|test)
    LOCAL_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()')
    kubectl port-forward svc/metro-timetable -n "metro-$ENV" "$LOCAL_PORT:80" &>/dev/null &
    PF_PID=$!
    trap "kill $PF_PID 2>/dev/null" EXIT
    sleep 1
    BASE_URL="http://localhost:$LOCAL_PORT"
    ;;
  prod)
    BASE_URL="https://hejnaluk.dev"
    ;;
  *) echo "Unknown env: $ENV. Use local|dev|test|prod."; exit 1 ;;
esac

request() {
  local url="$1"
  local response http_code body curl_exit
  response=$(curl -s --max-time 5 -w "\n%{http_code}" "$url")
  curl_exit=$?
  if [[ $curl_exit -eq 28 ]]; then
    echo "ERROR: Request timed out after 5s"
    return
  fi
  http_code=$(echo "$response" | tail -1)
  body=$(echo "$response" | head -n -1)
  echo "HTTP $http_code"
  echo "$body" | jq .
}

echo "Looping every ${INTERVAL}s against $BASE_URL. Press Ctrl+C to stop."
echo ""

while true; do
  echo "=== $(date '+%H:%M:%S') All directions, default limit ==="
  request "$BASE_URL/pid/station?station=Muzeum"

  echo ""
  echo "=== $(date '+%H:%M:%S') Direction 0 only ==="
  request "$BASE_URL/pid/station?station=Muzeum&direction=0"

  echo ""
  echo "=== $(date '+%H:%M:%S') Direction 0, limit 3 ==="
  request "$BASE_URL/pid/station?station=Muzeum&direction=0&limit=3"

  echo ""
  echo "---"
  sleep "$INTERVAL"
done
