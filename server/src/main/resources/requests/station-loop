#!/usr/bin/env bash

ENV=${1:-local}
INTERVAL=${2:-2}

case "$ENV" in
  local)
    BASE_URL="http://localhost:8080"
    ;;
  dev|test)
    LOCAL_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()')
    kubectl port-forward svc/metro-timetable -n "metro-$ENV" "$LOCAL_PORT:80" &>/dev/null &
    PF_PID=$!
    trap "kill $PF_PID 2>/dev/null" EXIT
    sleep 1
    BASE_URL="http://localhost:$LOCAL_PORT"
    ;;
  prod)
    BASE_URL="https://hejnaluk.dev"
    ;;
  *) echo "Unknown env: $ENV. Use local|dev|test|prod."; exit 1 ;;
esac

request() {
  local body="$1"
  local response http_code resp_body curl_exit
  response=$(curl -s --max-time 5 -w "\n%{http_code}" -X POST "$BASE_URL/pid/station" \
    -H "Content-Type: application/json" \
    -d "$body")
  curl_exit=$?
  if [[ $curl_exit -eq 28 ]]; then
    echo "ERROR: Request timed out after 5s"
    return
  fi
  http_code=$(echo "$response" | tail -1)
  resp_body=$(echo "$response" | head -n -1)
  echo "HTTP $http_code"
  echo "$resp_body" | jq .
}

STATIONS=("Muzeum" "Můstek" "Florenc" "Náměstí Republiky" "Hlavní nádraží" "Dejvická" "Hradčanská" "Malostranská" "Staroměstská" "Nusle" "I. P. Pavlova" "Vyšehrad")
DIRECTIONS=(0 1 "")
LIMITS=(2 3 5 10 "")

random_element() {
  local arr=("$@")
  echo "${arr[$((RANDOM % ${#arr[@]}))]}"
}

build_body() {
  local station direction limit body
  station=$(random_element "${STATIONS[@]}")
  direction=$(random_element "${DIRECTIONS[@]}")
  limit=$(random_element "${LIMITS[@]}")

  body="{\"station\": \"${station}\""
  [[ -n "$direction" ]] && body+=", \"direction\": ${direction}"
  [[ -n "$limit" ]]     && body+=", \"limit\": ${limit}"
  body+="}"

  echo "$body"
}

echo "Looping every ${INTERVAL}s against $BASE_URL (random params). Press Ctrl+C to stop."
echo ""

while true; do
  body=$(build_body)
  echo "=== $(date '+%H:%M:%S') POST /pid/station $body ==="
  request "$body"

  echo ""
  echo "---"
  sleep "$INTERVAL"
done
