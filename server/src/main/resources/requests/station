#!/usr/bin/env bash

ENV=${1:-local}
STATION=${2:-}
DIRECTION=${3:-}
LIMIT=${4:-}

case "$ENV" in
  local)
    BASE_URL="http://localhost:8080"
    ;;
  dev|test)
    LOCAL_PORT=$(python3 -c 'import socket; s=socket.socket(); s.bind(("",0)); print(s.getsockname()[1]); s.close()')
    kubectl port-forward svc/metro-timetable -n "metro-$ENV" "$LOCAL_PORT:80" &>/dev/null &
    PF_PID=$!
    trap "kill $PF_PID 2>/dev/null" EXIT
    sleep 1
    BASE_URL="http://localhost:$LOCAL_PORT"
    ;;
  prod)
    BASE_URL="https://hejnaluk.dev"
    ;;
  *) echo "Unknown env: $ENV. Use local|dev|test|prod."; exit 1 ;;
esac

STATIONS=(
  "Muzeum" "Stodůlky" "Florenc" "Můstek" "Náměstí Míru"
  "Hradčanská" "Dejvická" "Zličín" "Letňany" "Černý Most"
  "Chodov" "Háje" "Budějovická" "Pankrác" "Anděl"
)

if [ -z "$STATION" ]; then
  STATION="${STATIONS[$RANDOM % ${#STATIONS[@]}]}"
  echo "Random station: $STATION"
fi

build_body() {
  local body="{\"station\": \"$STATION\""
  [ -n "$DIRECTION" ] && body+=", \"direction\": $DIRECTION"
  [ -n "$LIMIT" ] && body+=", \"limit\": $LIMIT"
  body+="}"
  echo "$body"
}

BODY=$(build_body)
echo "Request: $BODY"

response=$(curl -s -w "\n%{http_code}" -X POST "$BASE_URL/pid/station" \
  -H "Content-Type: application/json" \
  -d "$BODY")
http_code=$(echo "$response" | tail -1)
resp_body=$(echo "$response" | head -n -1)
echo "HTTP $http_code"
echo "$resp_body" | jq .
